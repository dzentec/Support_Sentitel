@@ -0,0 +1,45 @@
+import httpx
+import asyncio
+from app.config import settings
+
+EMBEDDING_URL = "https://generativelanguage.googleapis.com/v1beta/models/text-embedding-004:embedContent"
+
+
+async def get_embedding(text: str, retries: int = 3) -> list[float]:
+    """
+    Get text embedding via Google Embedding API.
+    Retries up to 3 times with exponential backoff.
+    """
+    payload = {
+        "model": "models/text-embedding-004",
+        "content": {"parts": [{"text": text}]},
+    }
+    headers = {"X-goog-api-key": settings.GEMINI_API_KEY}
+
+    async with httpx.AsyncClient(timeout=10.0) as client:
+        for attempt in range(retries):
+            try:
+                resp = await client.post(EMBEDDING_URL, json=payload, headers=headers)
+                resp.raise_for_status()
+                return resp.json()["embedding"]["values"]
+            except Exception as e:
+                if attempt == retries - 1:
+                    raise EmbeddingAPIError(f"Embedding API unavailable: {e}") from e
+                await asyncio.sleep(2**attempt)
+
+
+async def get_embeddings_batch(texts: list[str]) -> list[list[float]]:
+    """
+    Batch fetch embeddings.
+    Sequentially with 100ms delay to respect rate limits.
+    """
+    results = []
+    for text in texts:
+        emb = await get_embedding(text)
+        results.append(emb)
+        await asyncio.sleep(0.1)
+    return results
+
+
+class EmbeddingAPIError(Exception):
+    pass
diff --git a/app/rag/indexer.py b/app/rag/indexer.py
